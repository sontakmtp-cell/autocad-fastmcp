PORTAL_PUBLIC_ORIGIN=http://localhost:3000
PORTAL_GATEWAY_BASE_URL=http://127.0.0.1:8000
PORTAL_SESSION_SECRET=replace-with-at-least-32-random-characters
PORTAL_OIDC_ISSUER=https://example.auth0.com/
PORTAL_OIDC_CLIENT_ID=replace-me
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_OIDC_AUDIENCE=https://cad.example.com/mcp
PORTAL_OIDC_SCOPES=openid profile email autocad.read autocad.write autocad.device.manage
# Fail closed: Phase 6 UI is hidden and Managed Write is disabled unless explicitly enabled.
PORTAL_PHASE6_UI_ENABLED=false
PORTAL_MANAGED_WRITE_UI_ENABLED=false
PORTAL_MANAGED_WRITE_KILL_SWITCH=true
# Phase 7 presentation and approval are independently fail-closed.
PORTAL_PHASE7_UI_ENABLED=false
PORTAL_RECENT_AUTH_APPROVAL_ENABLED=false
PORTAL_RECENT_AUTH_MAX_AGE_SECONDS=300

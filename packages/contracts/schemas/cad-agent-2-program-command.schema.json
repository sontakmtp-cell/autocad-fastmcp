{
  "$defs": {
    "CadProgram": {
      "additionalProperties": false,
      "description": "Gateway-owned semantic program.\n\nRuntime, package, capability, registry hash, policy, and execution digest\ndeliberately do not exist in this runtime-neutral model.",
      "properties": {
        "schema_version": {
          "const": "cad.program/0.2",
          "default": "cad.program/0.2",
          "title": "Schema Version",
          "type": "string"
        },
        "registry_version": {
          "const": "cad.program/0.2",
          "default": "cad.program/0.2",
          "title": "Registry Version",
          "type": "string"
        },
        "program_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Program Id",
          "type": "string"
        },
        "program_revision": {
          "minimum": 1,
          "title": "Program Revision",
          "type": "integer"
        },
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Device Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Document Id",
          "type": "string"
        },
        "expected_document_revision": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Expected Document Revision",
          "type": "string"
        },
        "operations": {
          "items": {
            "discriminator": {
              "mapping": {
                "create_circle": "#/$defs/CreateCircleOperation",
                "create_dimension_linear": "#/$defs/CreateDimensionLinearOperation",
                "create_line": "#/$defs/CreateLineOperation",
                "create_polyline": "#/$defs/CreatePolylineOperation",
                "create_rectangle": "#/$defs/CreateRectangleOperation",
                "create_text": "#/$defs/CreateTextOperation",
                "ensure_layer": "#/$defs/EnsureLayerOperation"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EnsureLayerOperation"
              },
              {
                "$ref": "#/$defs/CreateLineOperation"
              },
              {
                "$ref": "#/$defs/CreateCircleOperation"
              },
              {
                "$ref": "#/$defs/CreatePolylineOperation"
              },
              {
                "$ref": "#/$defs/CreateRectangleOperation"
              },
              {
                "$ref": "#/$defs/CreateTextOperation"
              },
              {
                "$ref": "#/$defs/CreateDimensionLinearOperation"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "document_revision_equals": "#/$defs/DocumentRevisionPrecondition"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DocumentRevisionPrecondition"
              }
            ]
          },
          "maxItems": 16,
          "title": "Preconditions",
          "type": "array"
        },
        "postconditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "entity_count": "#/$defs/EntityCountPostcondition",
                "layer_exists": "#/$defs/LayerExistsPostcondition"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EntityCountPostcondition"
              },
              {
                "$ref": "#/$defs/LayerExistsPostcondition"
              }
            ]
          },
          "maxItems": 64,
          "title": "Postconditions",
          "type": "array"
        },
        "budgets": {
          "$ref": "#/$defs/ProgramBudgets"
        }
      },
      "required": [
        "program_id",
        "program_revision",
        "device_id",
        "source_snapshot_id",
        "document_id",
        "expected_document_revision",
        "operations"
      ],
      "title": "CadProgram",
      "type": "object"
    },
    "CreateCircleOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "create_circle",
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Operation Id",
          "type": "string"
        },
        "layer": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^<>/\\\\\":;?*|=`\\x00-\\x1f]+$",
              "type": "string"
            },
            {
              "$ref": "#/$defs/LayerOutputRef"
            }
          ],
          "title": "Layer"
        },
        "center": {
          "$ref": "#/$defs/Point3d"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0,
          "title": "Radius",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "operation_id",
        "layer",
        "center",
        "radius"
      ],
      "title": "CreateCircleOperation",
      "type": "object"
    },
    "CreateDimensionLinearOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "create_dimension_linear",
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Operation Id",
          "type": "string"
        },
        "layer": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^<>/\\\\\":;?*|=`\\x00-\\x1f]+$",
              "type": "string"
            },
            {
              "$ref": "#/$defs/LayerOutputRef"
            }
          ],
          "title": "Layer"
        },
        "extension_line1_point": {
          "$ref": "#/$defs/Point3d"
        },
        "extension_line2_point": {
          "$ref": "#/$defs/Point3d"
        },
        "dimension_line_point": {
          "$ref": "#/$defs/Point3d"
        },
        "text_override": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Override"
        }
      },
      "required": [
        "kind",
        "operation_id",
        "layer",
        "extension_line1_point",
        "extension_line2_point",
        "dimension_line_point"
      ],
      "title": "CreateDimensionLinearOperation",
      "type": "object"
    },
    "CreateLineOperation": {
      "additionalProperties": false,

    "ProgramValidationRequest": {
      "additionalProperties": false,
      "properties": {
        "validation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Validation Id",
          "type": "string"
        },
        "receipt_id": {
          "maxLength": 128,

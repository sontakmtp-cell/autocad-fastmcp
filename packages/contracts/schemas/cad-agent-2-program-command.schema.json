  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "cad.agent/2",
      "default": "cad.agent/2",
      "title": "Protocol Version",
      "type": "string"
    },
    "message_type": {
      "const": "command",
      "default": "command",
      "title": "Message Type",
      "type": "string"
    },
    "message_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "device_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "command_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Command Id",
      "type": "string"
    },
    "sequence": {
      "default": 0,
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "issued_at": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Issued At",
      "type": "string"
    },
    "deadline_at": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline At"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "kind": {
      "enum": [
        "program_preview",
        "program_commit",
        "program_validate"
      ],
      "title": "Kind",
      "type": "string"
    },
    "effect_class": {
      "enum": [
        "write",
        "read"
      ],
      "title": "Effect Class",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/ProgramExecutionBinding"
    },
    "program": {
      "anyOf": [
        {
          "$ref": "#/$defs/CadProgram"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preview_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Id"
    },
    "preview_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Digest"
    },
    "receipt_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Id"
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProgramValidationRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "session_id",
    "device_id",
    "job_id",
    "command_id",
    "idempotency_key",
    "payload_hash",
    "kind",
    "effect_class",
    "binding"
  ],
  "title": "cad.agent/2 typed CAD Program command",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kythuatvang.local/cad.agent/2/program-command.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "program_preview"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "program",
          "preview_id"
        ],
        "properties": {
          "effect_class": {
            "const": "write"
          },
          "program": {
            "$ref": "#/$defs/CadProgram"
          },
          "preview_id": {
            "type": "string"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "preview_digest"
              ]
            },
            {
              "required": [
                "receipt_id"
              ]
            },
            {
              "required": [
                "validation"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "program_commit"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "program",
          "preview_id",
          "preview_digest",
          "receipt_id"
        ],
        "properties": {
          "effect_class": {
            "const": "write"
          },
          "program": {
            "$ref": "#/$defs/CadProgram"
          },
          "preview_id": {
            "type": "string"
          },
          "preview_digest": {
            "type": "string"
          },
          "receipt_id": {
            "type": "string"
          }
        },
        "not": {
          "required": [
            "validation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "program_validate"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "validation"
        ],
        "properties": {
          "effect_class": {
            "const": "read"
          },
          "validation": {
            "$ref": "#/$defs/ProgramValidationRequest"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "program"
              ]
            },
            {
              "required": [
                "preview_id"
              ]
            },
            {
              "required": [
                "preview_digest"
              ]
            },
            {
              "required": [
                "receipt_id"
              ]
            }
          ]
        }
      }
    }
  ]
}

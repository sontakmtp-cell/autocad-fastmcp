{
  "$defs": {
    "CreateCircleOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "create_circle",
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Operation Id",
          "type": "string"
        },
        "layer": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^<>/\\\\\":;?*|=`\\x00-\\x1f]+$",
              "type": "string"
            },
            {
              "$ref": "#/$defs/LayerOutputRef"
            }
          ],
          "title": "Layer"
        },
        "center": {
          "$ref": "#/$defs/Point3d"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0,
          "title": "Radius",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "operation_id",
        "layer",
        "center",
        "radius"
      ],
      "title": "CreateCircleOperation",
      "type": "object"
    },
    "CreateDimensionLinearOperation": {

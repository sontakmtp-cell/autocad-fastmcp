        },
        "text": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0,
          "title": "Height",
          "type": "number"
        },
        "rotation_radians": {
          "default": 0.0,
          "maximum": 6.283185307179586,
          "minimum": -6.283185307179586,
          "title": "Rotation Radians",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "operation_id",
        "layer",
        "position",
        "text",
        "height"
      ],
      "title": "CreateTextOperation",
      "type": "object"
    },
    "DocumentRevisionPrecondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "document_revision_equals",
          "title": "Kind",
          "type": "string"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Document Id",
          "type": "string"
        },
        "expected_document_revision": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Expected Document Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "document_id",
        "expected_document_revision"
      ],
      "title": "DocumentRevisionPrecondition",
      "type": "object"
    },
    "EnsureLayerOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ensure_layer",
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Operation Id",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^<>/\\\\\":;?*|=`\\x00-\\x1f]+$",
          "title": "Name",
          "type": "string"
        },
        "color_index": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Index"
        }
      },
      "required": [
        "kind",
        "operation_id",
        "name"
      ],
      "title": "EnsureLayerOperation",
      "type": "object"
    },
    "EntityCountPostcondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "entity_count",
          "title": "Kind",

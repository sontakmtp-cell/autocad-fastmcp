        "layer": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[^<>/\\\\\":;?*|=`\\x00-\\x1f]+$",
              "type": "string"
            },
            {
              "$ref": "#/$defs/LayerOutputRef"
            }
          ],
          "title": "Layer"
        },
        "extension_line1_point": {
          "$ref": "#/$defs/Point3d"
        },
        "extension_line2_point": {
          "$ref": "#/$defs/Point3d"
        },
        "dimension_line_point": {
          "$ref": "#/$defs/Point3d"
        },
        "text_override": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Override"
        }
      },
      "required": [
        "kind",
        "operation_id",
        "layer",
        "extension_line1_point",
        "extension_line2_point",
        "dimension_line_point"
      ],
      "title": "CreateDimensionLinearOperation",
      "type": "object"
    },

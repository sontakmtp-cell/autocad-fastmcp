        },
        "expected_created": {
          "maximum": 256,
          "minimum": 0,
          "title": "Expected Created",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "expected_created"
      ],
      "title": "EntityCountPostcondition",
      "type": "object"
    },
    "LayerExistsPostcondition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "layer_exists",
          "title": "Kind",

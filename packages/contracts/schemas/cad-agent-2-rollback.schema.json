        },
        "checkpoint_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checkpoint Digest",
          "type": "string"
        },
        "rollback_plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rollback Plan Id",
          "type": "string"
        },
        "rollback_execution_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rollback Execution Digest",
          "type": "string"
        },
        "expires_at": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "checkpoint_id",
        "checkpoint_digest",
        "rollback_plan_id",
        "rollback_execution_digest",
        "expires_at"
      ],
      "title": "RollbackPreviewArguments",
      "type": "object"
    },
    "RollbackPreviewResult": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Checkpoint Id",
          "type": "string"
        },
        "checkpoint_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checkpoint Digest",
          "type": "string"
        },
        "current_document_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Current Document Revision",
          "type": "string"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "conflicts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 256,
          "title": "Conflicts",
          "type": "array"
        },
        "milestone": {
          "const": "transaction_aborted",
          "title": "Milestone",
          "type": "string"
        },
        "runtime_pins": {
          "additionalProperties": true,
          "title": "Runtime Pins",
          "type": "object"
        },
        "policy_pins": {
          "additionalProperties": true,
          "title": "Policy Pins",
          "type": "object"
        }
      },
      "required": [
        "checkpoint_id",
        "checkpoint_digest",
        "current_document_revision",
        "eligible",
        "milestone",
        "runtime_pins",
        "policy_pins"
      ],
      "title": "RollbackPreviewResult",
      "type": "object"
    },
    "RollbackResultMessage": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "cad.agent/2",
          "default": "cad.agent/2",
          "title": "Protocol Version",
          "type": "string"
        },
        "message_type": {
          "const": "result",
          "default": "result",
          "title": "Message Type",
          "type": "string"
        },
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "job_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "command_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "sequence": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "issued_at": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Issued At",
          "type": "string"
        },
        "deadline_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline At"
        },
        "kind": {
          "enum": [
            "receipt_lookup",
            "checkpoint_lookup",
            "rollback_preview",
            "rollback_commit",
            "rollback_validate"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "outcome_unknown"
          ],
          "title": "Status",
          "type": "string"

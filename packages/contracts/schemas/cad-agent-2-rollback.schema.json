        "document_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Revision",
          "type": "string"
        },
        "checks": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Checks",
          "type": "array"
        },
        "failures": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Failures",
          "type": "array"
        }
      },
      "required": [
        "rollback_receipt_id",
        "valid",
        "document_revision"
      ],
      "title": "RollbackValidateResult",
      "type": "object"

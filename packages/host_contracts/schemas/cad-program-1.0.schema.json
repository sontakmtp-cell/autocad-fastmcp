      "type": "object"
    },
    "OpaqueComponentRef": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Component Id",
          "type": "string"
        },
        "owner_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Owner Id",
          "type": "string"
        },
        "component_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Component Version",
          "type": "string"
        },
        "content_type": {
          "const": "application/vnd.autocad-mcp.component+json",
          "title": "Content Type",
          "type": "string"
        },
        "byte_length": {
          "maximum": 5242880,
          "minimum": 1,
          "title": "Byte Length",
          "type": "integer"
        },
        "component_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Component Digest",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "owner_id",
        "component_version",
        "content_type",
        "byte_length",
        "component_digest"
      ],
      "title": "OpaqueComponentRef",
      "type": "object"
    },
    "PolarRepeat": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "polar",
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "$ref": "#/$defs/Expression"
        },
        "center": {
          "$ref": "#/$defs/ExpressionPoint3d"
        },
        "total_angle": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": [
        "kind",
        "count",
        "center",
        "total_angle"
      ],
      "title": "PolarRepeat",
      "type": "object"
    },
    "ProgramV1Budgets": {
      "additionalProperties": false,
      "properties": {
        "max_source_operations": {
          "default": 256,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Source Operations",
          "type": "integer"
        },
        "max_expanded_operations": {
          "default": 1024,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Expanded Operations",
          "type": "integer"
        },
        "max_entities": {
          "default": 1024,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Entities",
          "type": "integer"
        },
        "max_vertices": {
          "default": 4096,
          "maximum": 4096,
          "minimum": 2,
          "title": "Max Vertices",
          "type": "integer"
        },
        "max_expression_nodes": {
          "default": 1024,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Expression Nodes",
          "type": "integer"
        },
        "max_coordinate_abs_mm": {
          "default": "1000000000",
          "maxLength": 40,
          "pattern": "^-?(?:0|[1-9][0-9]{0,18})(?:\\.[0-9]{1,18})?$",
          "title": "Max Coordinate Abs Mm",
          "type": "string"
        },
        "max_text_bytes": {
          "default": 65536,
          "maximum": 65536,
          "minimum": 1,
          "title": "Max Text Bytes",
          "type": "integer"
        }
      },
      "title": "ProgramV1Budgets",
      "type": "object"
    },
    "RectangularRepeat": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "rectangular",
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "$ref": "#/$defs/Expression"
        },
        "columns": {
          "$ref": "#/$defs/Expression"
        },
        "row_offset": {
          "$ref": "#/$defs/ExpressionPoint3d"
        },
        "column_offset": {
          "$ref": "#/$defs/ExpressionPoint3d"
        }
      },
      "required": [
        "kind",
        "rows",
        "columns",
        "row_offset",
        "column_offset"
      ],
      "title": "RectangularRepeat",
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/NumericValue"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Variable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cad.program/1.0",
      "default": "cad.program/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "registry_version": {
      "default": "cad.program/1.0-create-core",
      "enum": [
        "cad.program/1.0-create-core",
        "cad.program/1.0-phase8-core"
      ],
      "title": "Registry Version",
      "type": "string"
    },
    "program_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Program Id",
      "type": "string"
    },
    "program_revision": {
      "minimum": 1,
      "title": "Program Revision",
      "type": "integer"
    },
    "parent_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Revision"
    },
    "device_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Device Id",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "document_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Document Id",
      "type": "string"
    },
    "expected_document_revision": {
      "pattern": "^\\S{1,256}$",
      "title": "Expected Document Revision",
      "type": "string"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/Variable"
      },
      "maxItems": 64,
      "title": "Variables",
      "type": "array"
    },
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "copy_entity": "#/$defs/CopyEntitySource",
            "create_circle": "#/$defs/CreateCircleSource",
            "create_dimension_linear": "#/$defs/CreateDimensionLinearSource",
            "create_line": "#/$defs/CreateLineSource",
            "create_polyline": "#/$defs/CreatePolylineSource",
            "create_rectangle": "#/$defs/CreateRectangleSource",
            "create_text": "#/$defs/CreateTextSource",
            "ensure_layer": "#/$defs/EnsureLayerSource",
            "move_entity": "#/$defs/MoveEntitySource",
            "offset_entity": "#/$defs/OffsetEntitySource"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/EnsureLayerSource"
          },
          {
            "$ref": "#/$defs/CreateLineSource"
          },
          {
            "$ref": "#/$defs/CreateCircleSource"
          },
          {
            "$ref": "#/$defs/CreatePolylineSource"
          },
          {
            "$ref": "#/$defs/CreateRectangleSource"
          },
          {
            "$ref": "#/$defs/CreateTextSource"
          },
          {
            "$ref": "#/$defs/CreateDimensionLinearSource"
          },
          {
            "$ref": "#/$defs/CopyEntitySource"
          },
          {
            "$ref": "#/$defs/OffsetEntitySource"
          },
          {
            "$ref": "#/$defs/MoveEntitySource"
          }
        ]
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "budgets": {
      "$ref": "#/$defs/ProgramV1Budgets"
    },
    "required_capabilities": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Required Capabilities",
      "type": "array"
    },
    "validation_profiles": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Validation Profiles",
      "type": "array"
    },
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/OpaqueArtifactRef"
      },
      "maxItems": 32,
      "title": "Artifact Refs",
      "type": "array"
    },
    "component_refs": {
      "items": {
        "$ref": "#/$defs/OpaqueComponentRef"
      },
      "maxItems": 32,
      "title": "Component Refs",
      "type": "array"
    },
    "semantic_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Semantic Digest",
      "type": "string"
    }
  },
  "required": [
    "program_id",
    "program_revision",
    "device_id",
    "source_snapshot_id",
    "document_id",
    "expected_document_revision",
    "operations",
    "validation_profiles",
    "semantic_digest"
  ],
  "title": "Immutable CAD Program 1.0 source contract",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kythuatvang.local/cad.program/1.0/schema.json"
}

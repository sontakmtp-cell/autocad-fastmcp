{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kythuatvang.local/cad.host/1/phase7-rollback.schema.json",
  "title": "Phase 7 Managed Host checkpoint and rollback records",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkpoint_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "entity_type", "layer", "canonical_fingerprint"],
      "properties": {
        "handle": { "type": "string", "pattern": "^[0-9A-F]{1,32}$" },
        "entity_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "layer": { "type": "string", "minLength": 1, "maxLength": 255 },
        "canonical_fingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_digest",
        "execution_digest",
        "document_id",
        "document_revision",
        "runtime_id",
        "runtime_role",
        "host_family",
        "host_version",
        "package_id",
        "package_version",
        "package_hash",
        "capability_manifest_hash",
        "operation_registry_version",
        "operation_registry_hash",
        "policy_version"
      ],
      "properties": {
        "program_digest": { "$ref": "#/$defs/digest" },
        "execution_digest": { "$ref": "#/$defs/digest" },
        "document_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "document_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runtime_id": { "const": "managed_dotnet" },
        "runtime_role": { "const": "primary" },
        "host_family": { "const": "R25" },
        "host_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "package_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "package_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "package_hash": { "$ref": "#/$defs/digest" },
        "capability_manifest_hash": { "$ref": "#/$defs/digest" },
        "operation_registry_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "operation_registry_hash": { "$ref": "#/$defs/digest" },
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checkpoint_id",
        "original_receipt_id",
        "original_receipt_digest",
        "program_id",
        "program_revision",
        "program_digest",
        "preview_id",
        "preview_digest",
        "execution_digest",
        "document_id",
        "document_revision_before",
        "document_revision_after",
        "created_entities",
        "non_entity_object_created",
        "runtime_and_policy_pins",
        "created_at",
        "checkpoint_digest"
      ],
      "properties": {
        "schema_version": { "const": "cad.rollback.checkpoint/1" },
        "checkpoint_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "original_receipt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "original_receipt_digest": { "$ref": "#/$defs/digest" },
        "program_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "program_revision": { "type": "integer", "minimum": 1 },
        "program_digest": { "$ref": "#/$defs/digest" },
        "preview_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "preview_digest": { "$ref": "#/$defs/digest" },
        "execution_digest": { "$ref": "#/$defs/digest" },
        "document_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "document_revision_before": { "type": "string", "minLength": 1, "maxLength": 256 },
        "document_revision_after": { "type": "string", "minLength": 1, "maxLength": 256 },
        "created_entities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/checkpoint_entity" }
        },
        "non_entity_object_created": { "type": "boolean" },
        "runtime_and_policy_pins": { "$ref": "#/$defs/execution_binding" },
        "created_at": { "type": "string", "format": "date-time" },
        "checkpoint_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "rollback_preview_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "checkpoint_digest",
        "rollback_plan_id",
        "rollback_execution_digest",
        "expires_at"
      ],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checkpoint_digest": { "$ref": "#/$defs/digest" },
        "rollback_plan_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rollback_execution_digest": { "$ref": "#/$defs/digest" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "rollback_commit_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "checkpoint_digest",
        "rollback_plan_id",
        "rollback_plan_digest",
        "rollback_execution_digest",
        "rollback_receipt_id",
        "expires_at"
      ],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checkpoint_digest": { "$ref": "#/$defs/digest" },
        "rollback_plan_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rollback_plan_digest": { "$ref": "#/$defs/digest" },
        "rollback_execution_digest": { "$ref": "#/$defs/digest" },
        "rollback_receipt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/checkpoint" },
    { "$ref": "#/$defs/rollback_preview_request" },
    { "$ref": "#/$defs/rollback_commit_request" }
  ]
}
